# =========================================================================
# TripAI environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# EXPO_PUBLIC_* values are embedded in the client bundle (safe to expose).
# All others are server-only (API routes / Inngest / drizzle-kit).
# =========================================================================

# --- Client (public) -----------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
# The deployed API origin the native app calls. In local dev, leave unset and
# Expo uses the dev server origin automatically.
EXPO_PUBLIC_API_ORIGIN=https://your-deployment.example.com
# Native Google Maps rendering keys (injected into the native build).
GOOGLE_MAPS_IOS_KEY=AIza_xxx
GOOGLE_MAPS_ANDROID_KEY=AIza_xxx

# --- Server-only ---------------------------------------------------------
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/tripai?sslmode=require
CLERK_SECRET_KEY=sk_test_xxx
# Signing secret for the Clerk webhook endpoint (Dashboard → Webhooks → your
# endpoint → Signing Secret). Used by svix to verify `user.created` deliveries.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
OPENAI_API_KEY=sk-xxx
# Server-side Google key with the Geocoding API enabled (can differ from the
# platform-restricted rendering keys above).
GOOGLE_GEOCODING_KEY=AIza_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
# Inngest runs in DEV MODE for now — leave these UNSET so the SDK connects to
# the local dev server (`npx inngest-cli@latest dev`). Only set them in prod.
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=signkey-xxx
SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# Build-time only: uploads source maps so Sentry stack traces are readable.
SENTRY_AUTH_TOKEN=sntrys_xxx

# Free-tier trip generation quota per user
TRIP_QUOTA_PER_USER=3
